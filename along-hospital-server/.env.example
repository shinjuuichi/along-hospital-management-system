# ========================================
# Docker Compose Image Tagging
# ========================================
DOCKER_REGISTRY=docker.io
NAMESPACE_LC=shinjuuichi
VERSION=

# ========================================
# ASP.NET Core Configuration
# ========================================
ASPNETCORE_ENVIRONMENT=Development

# ========================================
# Observability Stack Configuration
# ========================================
OBSERVABILITY_CONFIG_DIR=/opt/along-hospital-server/infra/observability

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# OpenTelemetry Collector Configuration (Standard SDK Environment Variables)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317   # docker-compose default | Swarm example: http://observability_otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# ========================================
# Infrastructure Services Configuration
# ========================================
# NOTE: Host/endpoint variables (DB_HOST, RABBITMQ_HOST, REDIS_HOST, etc.)
# are used by docker-compose.override.yml and the Swarm stack files.
# Their default Swarm targets assume the standard stack names:
# infra -> infra_sqlserver / infra_rabbitmq / infra_redis / infra_mongodb / infra_qdrant
# observability -> observability_otel-collector
# Override them here if your Swarm stack names differ.

# SQL Server
SQL_SA_PASSWORD=Hospital@123
DB_HOST=sqlserver                          # docker-compose default | Swarm example: infra_sqlserver
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Hospital@123

# MongoDB
DB_HOST_MONGO=mongodb                      # docker-compose default | Swarm example: infra_mongodb
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=Hospital

# Redis
REDIS_HOST=redis:6379                      # docker-compose default | Swarm example: infra_redis:6379
REDIS_INSTANCE_NAME=AlongHospital
REDIS_PASSWORD=Hospital@123

# RabbitMQ
RABBITMQ_HOST=amqp://rabbitmq:5672         # docker-compose default | Swarm example: amqp://infra_rabbitmq:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ========================================
# Qdrant Configuration (LLM Service)
# ========================================
QDRANT_HOST=qdrant                         # docker-compose default | Swarm example: infra_qdrant
QDRANT_PORT=6334
QDRANT_COLLECTION_NAME=along-hospital-embeddings
QDRANT_VECTOR_SIZE=768

