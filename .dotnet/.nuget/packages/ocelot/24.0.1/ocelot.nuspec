<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Ocelot</id>
    <version>24.0.1</version>
    <authors>Tom Pallister, Raman Maksimchuk</authors>
    <license type="file">LICENSE.md</license>
    <licenseUrl>https://aka.ms/deprecateLicenseUrl</licenseUrl>
    <icon>ocelot_icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/ThreeMammals/Ocelot</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/ThreeMammals/Ocelot/assets/images/ocelot_icon_128x128.png</iconUrl>
    <description>Ocelot is an API gateway based on .NET stack.</description>
    <releaseNotes>Upgrade to .NET 9 with supported TFMs (net8.0;net9.0)</releaseNotes>
    <copyright>© 2025 Three Mammals. MIT licensed OSS</copyright>
    <tags>API Gateway .NET Core .NET</tags>
    <repository type="git" url="https://github.com/ThreeMammals/Ocelot.git" commit="6d4cc632ec141c37db6d47a7da3a2d9585885c8b" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="FluentValidation" version="11.11.0" exclude="Build,Analyzers" />
        <dependency id="IPAddressRange" version="6.2.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.MiddlewareAnalysis" version="8.0.15" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Mvc.NewtonsoftJson" version="8.0.15" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DiagnosticAdapter" version="3.1.32" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="FluentValidation" version="11.11.0" exclude="Build,Analyzers" />
        <dependency id="IPAddressRange" version="6.2.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.MiddlewareAnalysis" version="9.0.4" exclude="Build,Analyzers" />
        <dependency id="Microsoft.AspNetCore.Mvc.NewtonsoftJson" version="9.0.4" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.DiagnosticAdapter" version="3.1.32" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>