<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Serilog.Sinks.OpenTelemetry</id>
    <version>4.1.1</version>
    <authors>Serilog Contributors</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>serilog-sink-nuget.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/serilog/serilog-sinks-opentelemetry</projectUrl>
    <description>This Serilog sink transforms Serilog events into OpenTelemetry
            logs and sends them to an OTLP (gRPC or HTTP) endpoint.</description>
    <tags>serilog sink opentelemetry</tags>
    <repository type="git" url="https://github.com/serilog/serilog-sinks-opentelemetry" commit="b894851cb04a4203707a1243bf0f66ff6c278be8" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Google.Protobuf" version="3.26.1" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.62.0" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.1">
        <dependency id="Google.Protobuf" version="3.26.1" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.62.0" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="Google.Protobuf" version="3.26.1" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.62.0" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Google.Protobuf" version="3.26.1" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.62.0" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Google.Protobuf" version="3.26.1" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.62.0" exclude="Build,Analyzers" />
        <dependency id="Serilog" version="4.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.6.2, .NETFramework4.7.1" />
      <frameworkAssembly assemblyName="System.Core" targetFramework=".NETFramework4.6.2, .NETFramework4.7.1" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.6.2, .NETFramework4.7.1" />
    </frameworkAssemblies>
  </metadata>
</package>