<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Qdrant.Client</id>
    <version>1.16.1</version>
    <title>Qdrant .NET client</title>
    <authors>Qdrant and Contributors</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>nuget-icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/qdrant/qdrant-dotnet</projectUrl>
    <description>.NET client for Qdrant vector database</description>
    <releaseNotes>https://github.com/qdrant/qdrant-dotnet/releases</releaseNotes>
    <copyright>Qdrant</copyright>
    <tags>qdrant, database, vector, search</tags>
    <repository type="git" url="https://github.com/qdrant/qdrant-dotnet" commit="b1f6d32abb21dae0eb6b5a62b971cb58ecfcb032" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Google.Protobuf" version="3.31.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.71.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="Google.Protobuf" version="3.31.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.71.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Google.Protobuf" version="3.31.0" exclude="Build,Analyzers" />
        <dependency id="Grpc.Net.Client" version="2.71.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>