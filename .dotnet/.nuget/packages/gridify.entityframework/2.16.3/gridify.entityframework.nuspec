<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Gridify.EntityFramework</id>
    <version>2.16.3</version>
    <authors>Alireza Sabouri</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <description>Gridify (EntityFramework), Easy and optimized way to apply Filtering, Sorting, and Pagination using text-based data.</description>
    <repository type="git" url="https://github.com/alirezanet/Gridify" branch="refs/heads/master" commit="bb5a493c184d84bcf30894323ca74f4f5e355396" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Gridify" version="2.16.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[6.0.0, 7.0.0)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net7.0">
        <dependency id="Gridify" version="2.16.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[7.0.0, 8.0.0)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Gridify" version="2.16.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[8.0.0, 10.0.0)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="Gridify" version="2.16.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[9.0.0, 10.0.0)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Gridify" version="2.16.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[2.0.0, 3.0.0)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Gridify" version="2.16.3" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore" version="[2.0.0, 5.0.0)" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>