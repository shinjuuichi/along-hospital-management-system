<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MassTransit.EntityFrameworkCore</id>
    <version>8.5.2</version>
    <title>MassTransit.EntityFrameworkCore</title>
    <authors>Chris Patterson</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <icon>mt-logo-small.png</icon>
    <readme>NuGet.README.md</readme>
    <projectUrl>https://masstransit.io/</projectUrl>
    <description>MassTransit Entity Framework Core persistence support; MassTransit provides a developer-focused, modern platform for creating distributed applications without complexity.</description>
    <copyright>Copyright 2007-2024 Chris Patterson</copyright>
    <tags>MassTransit EF EFCore EntityFramework EntityFrameworkCore</tags>
    <repository type="git" url="https://github.com/MassTransit/MassTransit" branch="refs/heads/master" commit="96adb565f7cc311488d1df104549f924203be760" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="MassTransit" version="8.5.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="9.0.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Memory" version="9.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="MassTransit" version="8.5.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.EntityFrameworkCore.Relational" version="9.0.1" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Extensions.Caching.Memory" version="9.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>